# Copy to /etc/babi/app.env on the approved server. Never commit actual values.
# Use the same application DB password as MYSQL_PASSWORD in the MySQL env file.
MYSQL_PASSWORD=replace-with-local-babi-user-password
JWT_SECRET=replace-with-at-least-32-random-bytes
EMAIL_VERIFICATION_SECRET=replace-with-an-independent-random-secret
# Dedicated demo resources, provisioned separately; never point to the shared DB.
# BABI_DISCORD_DEMO_ENABLED=true
# Set privately on the demo server and restart the service after changing it.
# DISCORD_WEBHOOK_URL=replace-with-private-discord-webhook-url
# SPRING_DATASOURCE_URL=jdbc:mysql://replace-host:3306/babi_discord_demo
# SPRING_DATASOURCE_USERNAME=replace-with-demo-db-user
# BABI_DEMO_REDIS_HOST=replace-with-dedicated-redis-host
# BABI_DEMO_REDIS_PORT=replace-with-dedicated-non-default-port
# BABI_DEMO_REDIS_PASSWORD=replace-with-random-secret-at-least-24-characters
# BABI_DEMO_REDIS_MARKER=replace-with-48-or-more-lowercase-hex-characters

# Optional positive limits per 60 seconds (global and direct peer/shared proxy).
BABI_EMAIL_SEND_GLOBAL_PER_MINUTE=30
BABI_EMAIL_SEND_SOURCE_PER_MINUTE=10

# HTTPS invitation landing page (required for invitation delivery).
BABY_INVITATION_LINK_BASE_URL=https://your-demo-host.example.invalid/invite
# Gmail SMTP credentials are needed for real email delivery outside discord-demo.
MAIL_USERNAME=replace-with-mail-username
MAIL_PASSWORD=replace-with-mail-app-password
