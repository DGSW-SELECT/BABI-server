# Copy this file to .env and replace the placeholder values with your local settings.
# Keep shell syntax: quote values containing spaces or shell special characters.
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PASSWORD=replace-with-local-babi-user-password
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30

# Gmail SMTP sender account; replace this example address with your Gmail address.
MAIL_USERNAME=your-gmail-account@example.invalid
# Gmail app password for the sender account (not the account login password).
MAIL_PASSWORD=replace-with-your-gmail-app-password
# Independent random secret for HMAC-SHA256 verification-code hashing; do not reuse JWT_SECRET.
EMAIL_VERIFICATION_SECRET=replace-with-an-independent-random-secret
