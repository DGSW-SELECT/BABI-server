# Copy this file to .env and replace the placeholder values with your local settings.
# This file is read by Docker Compose and, with the local profile, by Spring Boot.
# Use unquoted simple KEY=value values: Java properties and Compose parse quoting,
# backslashes, dollar signs, and whitespace differently. Generate secrets as hex.
MYSQL_ROOT_PASSWORD=replace-with-local-root-password
MYSQL_PASSWORD=replace-with-local-babi-user-password
JWT_SECRET=replace_with_a_random_secret_at_least_32_bytes_long
JWT_ACCESS_TOKEN_EXPIRATION_MINUTES=30

# Independent random secret for HMAC-SHA256 verification-code hashing; do not reuse JWT_SECRET.
EMAIL_VERIFICATION_SECRET=replace-with-an-independent-random-secret

# HTTPS landing/app-link route, without query parameters or fragment. Required for invitation email sending.
BABY_INVITATION_LINK_BASE_URL=https://your-app.example.invalid/invite

# Dedicated demo resources only; never use real users or a shared DB/Redis.
BABI_DISCORD_DEMO_ENABLED=true
# Set the private channel webhook URL locally. Restart the server after changing it.
DISCORD_WEBHOOK_URL=replace-with-private-discord-webhook-url
BABI_DEMO_DB_URL=jdbc:mysql://127.0.0.1:13308/babi_discord_demo
BABI_DEMO_REDIS_HOST=127.0.0.1
BABI_DEMO_REDIS_PORT=16380
BABI_DEMO_REDIS_PASSWORD=replace-with-a-random-secret-at-least-24-characters
BABI_DEMO_REDIS_MARKER=replace-with-48-or-more-lowercase-hex-characters

# Optional positive limits per 60 seconds (global and direct peer/shared proxy).
BABI_EMAIL_SEND_GLOBAL_PER_MINUTE=30
BABI_EMAIL_SEND_SOURCE_PER_MINUTE=10
